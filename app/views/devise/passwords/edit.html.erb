<div class="container mt-4" style="max-width: 420px;">
  <h2 class="mb-4 text-center">パスワード変更</h2>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <%= f.hidden_field :reset_password_token %>

    <div class="mb-3">
      <%= f.label :password, "新しいパスワード", class: "form-label" %>
      <% if @minimum_password_length %>
        <small class="text-muted">（最低 <%= @minimum_password_length %> 文字）</small>
      <% end %>
      <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "form-control" %>
    </div>

    <div class="mb-3">
      <%= f.label :password_confirmation, "パスワード（確認）", class: "form-label" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control" %>
    </div>

    <div class="d-grid mb-3">
      <%= f.submit "パスワードを更新する", class: "btn btn-primary" %>
    </div>
  <% end %>
</div>
