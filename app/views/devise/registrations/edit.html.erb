<% content_for :title, "LiftLog - プロフィール編集" %>

<div class="container-fluid mt-2 profile-page">
  <style>
    .profile-page h2 { font-size: 1.4rem; margin-bottom: .75rem;}
    .profile-page form { background: #fff; border: 1px solid #e9f2fb; padding: 1rem; border-radius: .6rem; box-shadow: 0 1px 6px rgba(11,94,168,0.04); }
    .profile-page .form-label { font-weight: 600; color: #333; }
    .profile-page .form-control { padding: .6rem .75rem; border-radius: .5rem; }
    .profile-page .input-group-text { background: transparent; border-left: none; cursor: pointer; }
    .profile-page .btn-primary { font-weight: 700; padding: .55rem .75rem; }
    .profile-page .muted-note { color: #6c757d; font-size: .95rem; }
    .profile-page .action-links { margin-top: .75rem; }
    .profile-page .action-links .btn { padding: .55rem .75rem; }
    .profile-page .danger-note { color: #6c757d; font-size: .9rem; margin-top: .5rem; }
    @media (min-width: 768px) {
      .profile-page { max-width: 920px; margin-left: auto; margin-right: auto; padding-left: 1rem; padding-right: 1rem; }
    }
  </style>

  <h2 class="mb-4">プロフィール編集</h2>

  <%= render "devise/shared/error_messages" %>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
    <div class="mb-3">
      <%= f.label :username, "ユーザー名（20文字以下）", class: "form-label" %>
      <%= f.text_field :username, class: "form-control" %>
    </div>

    <% unless resource.sns_user? %>
      <div class="mb-3">
        <%= f.label :email, class: "form-label" %>
        <%= f.email_field :email, class: "form-control" %>
      </div>

      <div class="mb-3" data-controller="password-toggle">
        <%= f.label :password, "新しいパスワード（変更する場合）", class: "form-label" %>
        <div class="input-group">
          <%= f.password_field :password, class: "form-control", 
              data: { password_toggle_target: "input" }, placeholder: "6文字以上で入力" %>
          <span class="input-group-text" style="cursor: pointer" 
                data-action="click->password-toggle#toggle">
            <i class="fas fa-eye" data-password-toggle-target="icon"></i>
          </span>
        </div>
      </div>

      <div class="mb-3" data-controller="password-toggle">
        <%= f.label :password_confirmation, "新しいパスワード（確認）", class: "form-label" %>
        <div class="input-group">
          <%= f.password_field :password_confirmation, class: "form-control", 
              data: { password_toggle_target: "input" } %>
          <span class="input-group-text" style="cursor: pointer" 
                data-action="click->password-toggle#toggle">
            <i class="fas fa-eye" data-password-toggle-target="icon"></i>
          </span>
        </div>
      </div>

      <div class="mb-3" data-controller="password-toggle">
        <%= f.label :current_password, "現在のパスワード（必須）", class: "form-label" %>
        <div class="input-group">
          <%= f.password_field :current_password, class: "form-control", 
              data: { password_toggle_target: "input" }, autocomplete: "current-password" %>
          <span class="input-group-text" style="cursor: pointer" 
                data-action="click->password-toggle#toggle">
            <i class="fas fa-eye" data-password-toggle-target="icon"></i>
          </span>
        </div>
      </div>
    <% else %>
      <p class="text-muted">※ Googleログインを使用した場合、メールアドレスとパスワードは変更できません。</p>
    <% end %>

    <div class="mb-3">
      <%= f.submit "更新", class: "btn btn-primary w-100" %>
    </div>
  <% end %>
  <div class="action-links d-grid gap-2">
    <%= link_to "ログアウト", destroy_user_session_path,
                        data: { turbo_method: :delete, turbo_confirm: "ログアウトしますか？" },
                        class: "btn btn-outline-danger w-100" %>
  </div>

  <div class="delete-box mt-3 p-3 border border-danger rounded" style="background-color: #fff5f5;">
    <%= link_to "アカウント削除", registration_path(resource_name),
                data: { turbo_method: :delete, turbo_confirm: "本当にアカウントを削除しますか？" },
                class: "btn btn-danger w-100" %>

    <p class="danger-note mb-0 mt-2">※ アカウントを削除した場合、すべてのデータが削除されます。アカウントを再作成しても、元のデータは復元されません。</p>
  </div>
</div>
