<% content_for :title, "LiftLog - ログイン" %>

<div class="container mt-2">
  <h2 class="mb-4">ログイン</h2>

  <%= render "devise/shared/error_messages" %>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
    <div class="mb-3">
      <%= f.label :email, class: "form-label" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control" %>
    </div>

    <div class="mb-3" data-controller="password-toggle">
      <%= f.label :password, class: "form-label" %>
      <div class="input-group">
        <%= f.password_field :password, class: "form-control", 
            data: { password_toggle_target: "input" }, autocomplete: "current-password", placeholder: "6文字以上" %>
        <span class="input-group-text" style="cursor: pointer" 
              data-action="click->password-toggle#toggle">
          <i class="fas fa-eye" data-password-toggle-target="icon"></i>
        </span>
      </div>
    </div>

    <div class="mb-3 form-check">
      <%= f.check_box :remember_me, class: "form-check-input" %>
      <%= f.label :remember_me, class: "form-check-label" %>
    </div>

    <div class="mb-3">
      <%= f.submit "ログイン", class: "btn btn-primary w-100" %>
    </div>
  <% end %>

  <div class="mt-3 text-center">
    <p>または</p>
    <%= link_to user_google_oauth2_omniauth_authorize_path, class: "btn btn-warning w-100 mb-3" do %>
      <i class="fab fa-google"></i> Googleでログイン
    <% end %>
  </div>

  <%= render "devise/shared/links" %>
</div>
