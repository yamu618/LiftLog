<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "LiftLog" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">

    <%= favicon_link_tag "logo.png" %>
    <link rel="apple-touch-icon" sizes="180x180" href="<%= asset_path 'logo.png' %>">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <script type="module" src="/assets/application.js" defer></script>

    <title><%= content_for?(:title) ? yield(:title) : "LiftLog - 筋トレ管理アプリ" %></title>
    <meta name="description" content="<%= content_for?(:description) ? yield(:description) : "LiftLogは筋トレ記録・レポート閲覧が簡単にできる筋トレ管理アプリです。" %>">

    <meta property="og:title" content="<%= content_for?(:og_title) ? yield(:og_title) : "LiftLog - 筋トレ管理アプリ" %>">
    <meta property="og:description" content="<%= content_for?(:og_description) ? yield(:og_description) : "LiftLogは筋トレ記録・レポート閲覧が簡単にできる筋トレ管理アプリです。" %>">
    <meta property="og:image" content="<%= content_for?(:og_image) ? yield(:og_image) : image_url("liftlog_ogp.png") %>">
    <meta property="og:url" content="<%= request.original_url %>">
    <meta property="og:type" content="website">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= content_for?(:og_title) ? yield(:og_title) : "LiftLog - 筋トレ管理アプリ" %>">
    <meta name="twitter:description" content="<%= content_for?(:og_description) ? yield(:og_description) : "LiftLogは筋トレ記録・レポート閲覧が簡単にできる筋トレ管理アプリです。" %>">
    <meta name="twitter:image" content="<%= content_for?(:og_image) ? yield(:og_image) : image_url("liftlog_ogp.png") %>">
  </head>

  <body class="d-flex flex-column min-vh-100">
    <%= render 'shared/header' %>

    <turbo-frame id="flash">
      <%= render "shared/flash_messages" %>
      <%= render "shared/personal_best_toast" %>
    </turbo-frame>

    <main class="flex-fill">
      <%= yield %>
    </main>

    <%= render "shared/footer" %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL" crossorigin="anonymous"></script>
  </body>
</html>
