<% content_for :title, "LiftLog - トレーニングレポート" %>

<div class="container mt-2">
  <h2 class="mb-4">トレーニングレポート</h2>

  <div class="card mb-4 shadow-sm">
    <div class="card-header bg-dark text-white">
      <strong>トレーニング日数</strong>
    </div>
    <div class="card-body">
      <div class="d-flex justify-content-center flex-nowrap overflow-auto text-center">
        <div class="p-2 flex-shrink-0" style="min-width: 120px;">
          <p class="text-muted mb-1 fs-6">総日数</p>
          <h3 class="fw-bold fs-5"><%= @total_days %> 日</h3>
        </div>

        <div class="p-2 flex-shrink-0" style="min-width: 120px;">
          <p class="text-muted mb-1 fs-6">今週</p>
          <h3 class="fw-bold fs-5"><%= @this_week_days %> 日</h3>
          <p class="<%= @week_days_diff >= 0 ? 'text-success fw-semibold' : 'text-danger fw-semibold' %> fs-6">
            （前週比 <%= @week_days_diff >= 0 ? '+' : '' %><%= @week_days_diff %>）
          </p>
        </div>

        <div class="p-2 flex-shrink-0" style="min-width: 120px;">
          <p class="text-muted mb-1 fs-6">今月</p>
          <h3 class="fw-bold fs-5"><%= @this_month_days %> 日</h3>
          <p class="<%= @month_days_diff >= 0 ? 'text-success fw-semibold' : 'text-danger fw-semibold' %> fs-6">
            （前月比 <%= @month_days_diff >= 0 ? '+' : '' %><%= @month_days_diff %>）
          </p>
        </div>
      </div>
    </div>
  </div>

  <div class="card shadow-sm">
    <div class="card-header bg-dark text-white">
      <strong>総重量＆総距離レポート（月別）</strong>
    </div>
    <div class="card-body">
      <turbo-frame id="category_tabs_and_exercises">
        <ul class="nav nav-tabs mb-3 flex-wrap">
          <% @categories.each do |category| %>
            <li class="nav-item">
              <%= link_to category.name,
                          reports_path(category_id: category.id),
                          class: "nav-link #{'active' if category == @selected_category}",
                          data: { turbo_frame: "category_tabs_and_exercises" } %>
            </li>
          <% end %>
        </ul>

        <div class="d-flex flex-wrap gap-2 mb-3">
          <% exercises = @selected_category.name == "有酸素" ? @cardio_exercises : @exercises %>
          <% exercises.each do |exercise| %>
            <%= link_to exercise.name,
                        reports_path(exercise_id: exercise.id, category_id: @selected_category.id),
                        class: "btn btn-outline-primary btn-sm",
                        data: { turbo_frame: "chart" } %>
          <% end %>
        </div>
      </turbo-frame>

      <%= turbo_frame_tag "chart" do %>
        <% if @chart_data_rounded.present? %>
          <%= line_chart @chart_data_rounded,
                loading: "読み込み中です...",
                height: "250px",
                library: { 
                  title: { text: "#{@selected_exercise.name}の#{@selected_category.name == "有酸素" ? "総距離" : "総重量"}推移" },
                  yAxis: { title: { text: @selected_category.name == "有酸素" ? "km" : "kg" } },
                  responsive: {
                    rules: [{
                      condition: { maxWidth: 500 },
                      chartOptions: { legend: { enabled: false },
                                      yAxis: { labels: { style: { fontSize: '10px' } } } }
                          }]
                        }
                      } %>
        <% else %>
          <p class="text-muted text-center mb-0">
            種目を選択するとグラフが表示されます。
          </p>
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="card shadow-sm mt-4">
    <div class="card-header bg-dark text-white">
      <strong>自己ベスト（MAX重量＆MAX距離）</strong>
    </div>
    <div class="card-body">
      <turbo-frame id="category_tabs_and_exercises_personal_best">
        <ul class="nav nav-tabs mb-3 flex-wrap">
          <% @categories.each do |category| %>
            <li class="nav-item">
              <%= link_to category.name,
                          reports_path(category_id: category.id),
                          class: "nav-link #{'active' if category == @selected_category}",
                          data: { turbo_frame: "category_tabs_and_exercises_personal_best" } %>
            </li>
          <% end %>
        </ul>

        <div class="d-flex flex-wrap gap-2 mb-3">
          <% exercises = @selected_category.name == "有酸素" ? @cardio_exercises : @exercises %>
          <% exercises.each do |exercise| %>
            <%= link_to exercise.name,
                        reports_path(exercise_id: exercise.id, category_id: @selected_category.id),
                        class: "btn btn-outline-primary btn-sm",
                        data: { turbo_frame: "personal_best" } %>
          <% end %>
        </div>
      </turbo-frame>

      <turbo-frame id="personal_best">
        <% if @selected_exercise.present? %>
          <div class="border-top pt-3">
            <h5 class="fw-bold mb-1 text-center"><%= @selected_exercise.name %></h5>

            <% if @selected_category.name == "有酸素" %>
              <% if @exercise_best.present? %>
                <p class="fs-5 fw-bold mb-0 text-center">
                  自己ベストは<%= @exercise_best.round(2) %>kmです🔥
                </p>
              <% else %>
                <p class="text-muted mb-0">この種目には記録がありません。</p>
              <% end %>
            <% else %>
              <% if @exercise_best.present? %>
                <p class="fs-5 fw-bold mb-0 text-center">
                  自己ベストは<%= @exercise_best.round(2) %>kgです🔥
                </p>
              <% else %>
                <p class="text-muted mb-0">この種目には記録がありません。</p>
              <% end %>
            <% end %>
          </div>
        <% else %>
          <p class="text-muted text-center mb-0">
            種目を選択すると自己ベストが表示されます。
          </p>
        <% end %>
      </turbo-frame>
    </div>
</div>
