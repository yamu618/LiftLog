<header class="navbar navbar-expand-lg navbar-light bg-light border-bottom">
  <div class="container-fluid">
    <%= link_to root_path, class: "navbar-brand" do %>
      <strong class="text-primary">LiftLog</strong>
    <% end %>

    <div class="d-flex flex-wrap gap-2">
      <% if user_signed_in? %>
        <% if current_user.try(:admin?) %>
          <%= link_to "管理者ログイン", rails_admin_path, class: "btn btn-sm btn-outline-warning" %>
        <% end %>
        <%= link_to "TOP", workouts_path, class: "btn btn-sm btn-outline-primary" %>
        <%= link_to "レポート", reports_path, class: "btn btn-sm btn-outline-primary" %>
        <%= link_to "種目", exercises_path, class: "btn btn-sm btn-outline-primary" %>
        <%= link_to "設定", edit_user_registration_path, class: "btn btn-sm btn-outline-secondary" %>
        <%= link_to "ログアウト", destroy_user_session_path,
                      data: { turbo_method: :delete, turbo_confirm: "ログアウトしますか？" },
                      class: "btn btn-sm btn-outline-danger" %>
      <% else %>
        <%= link_to "新規会員登録", new_user_registration_path, class: "btn btn-outline-primary" %>
        <%= link_to "ログイン", new_user_session_path, class: "btn btn-primary" %>
      <% end %>
    </div>
  </div>
</header>
