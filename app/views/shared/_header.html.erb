<header class="navbar navbar-expand-lg navbar-light bg-light border-bottom">
  <div class="container-fluid d-flex flex-column align-items-center">

    <!-- ロゴ -->
    <%= link_to root_path, class: "d-flex align-items-center text-decoration-none mb-2" do %>
      <img src="<%= asset_path('logo.png') %>" alt="アイコン" width="32" height="32" class="me-2">
      <strong class="text-primary m-0">LiftLog</strong>
    <% end %>

    <!-- ナビリンク -->
    <div class="d-flex flex-wrap justify-content-center w-100 gap-2">
      <% if user_signed_in? %>
        <% if current_user.try(:admin?) %>
          <%= link_to "管理者ログイン", rails_admin_path, class: "btn btn-sm btn-outline-warning flex-fill text-center" %>
        <% end %>
        <%= link_to "TOP", workouts_path, class: "btn btn-sm btn-outline-primary flex-fill text-center" %>
        <%= link_to "レポート", reports_path, class: "btn btn-sm btn-outline-primary flex-fill text-center" %>
        <%= link_to "種目", exercises_path, class: "btn btn-sm btn-outline-primary flex-fill text-center" %>
        <%= link_to "設定", edit_user_registration_path, class: "btn btn-sm btn-outline-secondary flex-fill text-center" %>
        <%= link_to "使い方", how_to_path, class: "btn btn-sm btn-outline-warning flex-fill text-center" %>
      <% else %>
        <%= link_to "TOP", workouts_path, class: "btn btn-sm btn-outline-primary flex-fill text-center" %>
        <%= link_to "新規会員登録", new_user_registration_path, class: "btn btn-success btn-sm flex-fill text-center" %>
        <%= link_to "ログイン", new_user_session_path, class: "btn btn-sm btn-primary flex-fill text-center" %>
        <%= link_to "レポート", reports_path, class: "btn btn-sm btn-outline-secondary flex-fill text-center" %>
        <%= link_to "種目", exercises_path, class: "btn btn-sm btn-outline-secondary flex-fill text-center" %>
        <%= link_to "設定", edit_user_registration_path, class: "btn btn-sm btn-outline-secondary flex-fill text-center" %>
        <%= link_to "使い方", how_to_path, class: "btn btn-sm btn-outline-warning flex-fill text-center" %>
      <% end %>
    </div>
  </div>
</header>
