<%= turbo_frame_tag dom_id(@set) do %>
  <div class="card mb-2 shadow-sm">
    <div class="card-body p-2">
      <%= form_with(model: @set) do |f| %>
        <div class="d-flex gap-2 mb-2 ">
          <% if @set.workout.exercise.category.name == "有酸素" %>
            <div class="input-group">
              <%= f.number_field :duration, class: "form-control", step: 1, min: 0, placeholder: "時間" %>
              <span class="input-group-text">分</span>
            </div>
            <div class="input-group">
              <%= f.number_field :distance, class: "form-control", step: 0.01, min: 0, placeholder: "距離" %>
              <span class="input-group-text">km</span>
            </div>
          <% else %>
            <div class="input-group">
              <%= f.number_field :weight, class: "form-control", step: 0.01, min: 0, placeholder: "重量" %>
              <span class="input-group-text">kg</span>
            </div>
            <div class="input-group">
              <%= f.number_field :reps, class: "form-control", step: 1, min: 0, placeholder: "回数" %>
              <span class="input-group-text">回</span>
            </div>
          <% end %>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-2">
          <%= f.submit "更新", class: "btn btn-success btn-sm" %>
          <%= link_to "キャンセル",
                workout_path(@set.workout),
                data: { turbo_frame: dom_id(@set) },
                class: "btn btn-secondary btn-sm" %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
