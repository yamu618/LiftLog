<div class="container mt-2">
  <h2 class="mb-4"><%= @workout_title %></h2>

  <%= form_with url: workouts_path, method: :get, local: true, class: "row g-2 mb-4" do %>
    <div class="col-12 col-md-4">
      <%= label_tag :date, "日付", class: "form-label fw-semibold" %>
      <%= date_field_tag :date, @selected_date, class: "form-control w-100" %>
    </div>

    <div class="col-12 col-md-auto d-flex align-items-end mt-2 mt-md-0">
      <%= submit_tag "更新", class: "btn btn-primary w-100" %>
    </div>
  <% end %>

  <div>
    <% @workouts.each do |workout| %>
      <div class="card mb-2 shadow-sm">
        <div class="card-body p-2">
          <h6 class="card-title mb-1 fw-bold"><%= workout.exercise.name %></h6>

          <div class="d-flex flex-wrap gap-2 mb-2 small text-secondary">
            <span><strong>カテゴリ:</strong> <%= workout.exercise.category.name %></span>
            <span><strong>セット:</strong> <%= workout.workout_sets.count %></span>

            <% if workout.exercise.category.name == "有酸素" %>
              <span><strong>総距離:</strong> <%= workout.total_distance %> km</span>
              <span><strong>合計時間:</strong> <%= workout.total_duration %> 分</span>
            <% else %>
              <span><strong>総重量:</strong> <%= workout.total_weight %> kg</span>
            <% end %>
          </div>

          <div class="d-flex justify-content-end gap-1">
            <%= link_to "詳細", workout_path(workout), class: "btn btn-sm btn-primary" %>
            <%= link_to "削除", workout_path(workout),
                        data: { turbo_method: :delete, turbo_confirm: "削除しますか？" },
                        class: "btn btn-sm btn-danger" %>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <div class="mt-3">
    <%= link_to "ワークアウト追加", new_workout_path(date: @selected_date), class: "btn btn-success w-100 w-md-auto" %>
  </div>
</div>
