<h1 class="mb-4">ワークアウト</h1>

<div class="mb-3">
  <%= form_with url: workouts_path, method: :get, local: true, class: "form-inline" do %>
    <div class="form-group mr-2">
      <%= label_tag :date, "日付", class: "mr-2" %>
      <%= date_field_tag :date, params[:date] || Date.today, class: "form-control" %>
    </div>
    <%= submit_tag "絞り込む", class: "btn btn-primary" %>
  <% end %>
</div>

<table class="table table-striped table-bordered">
  <thead class="thead-light">
    <tr>
      <th>種目</th>
      <th>カテゴリー</th>
      <th>重量(kg)</th>
      <th>回数</th>
      <th>日付</th>
      <th>操作</th>
    </tr>
  </thead>
  <tbody>
    <% @workouts.each do |workout| %>
      <tr>
        <td><%= workout.exercise.name %></td>
        <td><%= workout.exercise.category.name %></td>
        <td><%= workout.weight %></td>
        <td><%= workout.reps %></td>
        <td><%= workout.performed_on %></td>
        <td>
          <%= link_to "編集", edit_workout_path(workout), class: "btn btn-sm btn-warning mr-1" %>
          <%= button_to "削除", workout_path(workout), method: :delete,
                data: { confirm: "本当に削除しますか？" },
                class: "btn btn-sm btn-danger" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= link_to "新規ワークアウトを追加", new_workout_path, class: "btn btn-success" %>
