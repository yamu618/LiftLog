<div class="container mt-2">
  <h2 class="mb-4"><%= @workout_title %></h1>

  <%= form_with url: workouts_path, method: :get, local: true, class: "row g-2 align-items-center mb-4" do %>
    <div class="col-auto">
      <%= label_tag :date, "日付", class: "form-label" %>
    </div>
    <div class="col-auto">
      <%= date_field_tag :date, @selected_date, class: "form-control" %>
    </div>
    <div class="col-auto">
      <%= submit_tag "絞り込む", class: "btn btn-primary" %>
    </div>
  <% end %>

  <table class="table table-striped table-bordered align-middle">
    <thead class="table-light">
      <tr>
        <th>カテゴリー</th>
        <th>種目</th>
        <th>セット数</th>
        <th>総重量</th>
        <th style="width: 180px;">操作</th>
      </tr>
    </thead>
    <tbody>
      <% @workouts.each do |workout| %>
        <tr>
          <td><%= workout.exercise.category.name %></td>
          <td><%= workout.exercise.name %></td>
          <td><%= workout.workout_sets.count %></td>
          <td><%= workout.total_weight %> kg</td>
          <td>
            <div class="d-flex gap-2">
              <%= link_to "詳細", workout_path(workout), class: "btn btn-sm btn-primary" %>
              <%= link_to "削除", workout_path(workout),
                          data: { turbo_method: :delete, turbo_confirm: "削除しますか？" },
                          class: "btn btn-sm btn-danger" %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <div class="mt-3">
    <%= link_to "ワークアウト追加", new_workout_path, class: "btn btn-success" %>
  </div>
</div>
