<h1>ワークアウト</h1>

<%= form_with url: workouts_path, method: :get, local: true, class: "form-inline mb-3" do %>
  <%= label_tag :date, "日付", class: "mr-2" %>
  <%= date_field_tag :date, @selected_date, class: "form-control mr-2" %>
  <%= submit_tag "絞り込む", class: "btn btn-primary" %>
<% end %>

<table class="table table-striped">
  <thead>
    <tr>
      <th>カテゴリー</th>
      <th>種目</th>
      <th>セット数</th>
      <th>総重量</th>
      <th>操作</th>
    </tr>
  </thead>
  <tbody>
    <% @workouts.each do |workout| %>
      <tr>
        <td><%= workout.exercise.category.name %></td>
        <td><%= workout.exercise.name %></td>
        <td><%= workout.workout_sets.count %></td>
        <td><%= workout.total_weight %> kg</td>
        <td>
          <%= link_to "詳細", workout_path(workout), class: "btn btn-sm btn-primary" %>
          <%= button_to "削除", workout_path(workout), method: :delete, data: { turbo_method: :delete, turbo_confirm: "削除しますか？" }, class: "btn btn-sm btn-danger" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= link_to "ワークアウト追加", new_workout_path, class: "btn btn-success" %>
