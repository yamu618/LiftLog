<% content_for :title, "LiftLog - TOPページ" %>
<% content_for :description, "LiftLogは筋トレ記録・レポート閲覧が簡単にできる筋トレ管理アプリです。" %>
<% content_for :og_title, "LiftLog - 筋トレ管理アプリ" %>
<% content_for :og_description, "LiftLogは筋トレ記録・レポート閲覧が簡単にできる筋トレ管理アプリです。" %>
<% content_for :og_image, image_url("liftlog_ogp.png") %>

<% if flash[:training_milestone] %>
  <div class="position-fixed top-0 end-0 p-3" style="z-index: 1055; margin-top: 4rem;">
    <div class="toast show align-items-center text-bg-primary border-0">
      <div class="d-flex">
        <div class="toast-body">
          <%= flash[:training_milestone] %>
        </div>
        <button type="button" class="btn-close btn-close-white me-2 m-auto"
                data-bs-dismiss="toast" aria-label="Close"></button>
      </div>
    </div>
  </div>
<% end %>

<turbo-frame id="calendar_and_workouts">
  <div class="container mt-2">
    <h2 class="mb-3"><%= @workout_title %></h2>

    <div class="mb-4">
      <%= month_calendar(events: @all_workouts, attribute: :performed_on, start_date: @start_date) do |date, workouts| %>
        <%= render 'month_calendar', 
            start_date: @start_date, 
            selected_date: @selected_date %>
      <% end %>
    </div>

    <h5 class="mb-3"><%= @selected_date.strftime("%Y年%m月%d日") %> の記録</h5>

    <div>
      <% if @workouts.any? %>
        <% @workouts.each do |workout| %>
          <div id="<%= dom_id(workout) %>" class="card mb-2 shadow-sm">
            <div class="card-body p-2">
              <h6 class="card-title mb-1 fw-bold"><%= workout.exercise.name %></h6>

              <div class="d-flex flex-wrap gap-2 mb-2 small text-secondary">
                <span><strong>カテゴリ:</strong> <%= workout.exercise.category.name %></span>
                <span><strong>セット:</strong> <%= workout.workout_sets.count %></span>

                <% if workout.exercise.category.name == "有酸素" %>
                  <span><strong>総距離:</strong> <%= workout.total_distance.round(2) %> km</span>
                  <span><strong>合計時間:</strong> <%= workout.total_duration %> 分</span>
                <% else %>
                  <span><strong>総重量:</strong> <%= workout.total_weight.round(2) %> kg</span>
                <% end %>
              </div>

              <div class="d-flex justify-content-end gap-1">
                <%= link_to "セット管理", workout_path(workout, start_date: @start_date.beginning_of_month), class: "btn btn-sm btn-primary", data: { turbo: false } %>
                <%= link_to "削除", workout_path(workout, start_date: @start_date.beginning_of_month),
                            data: { turbo_method: :delete, turbo_confirm: "削除しますか？" },
                            class: "btn btn-sm btn-danger" %>
              </div>
            </div>
          </div>
        <% end %>
      <% else %>
        <p>この日の記録はありません。ワークアウト追加ボタンから種目を登録してください。</p>
      <% end %>
    </div>

    <div class="mt-3">
      <%= link_to "ワークアウト追加", new_workout_path(date: @selected_date, start_date: @start_date.beginning_of_month), class: "btn btn-success w-100 w-md-auto", data: { turbo: false } %>
    </div>
  </div>
</turbo-frame>
