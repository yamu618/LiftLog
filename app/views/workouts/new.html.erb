<div class="container mt-2">
  <h2 class="mb-4">新規ワークアウト</h2>

  <% if @workout.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% @workout.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @workout, local: true do |f| %>
    <div class="mb-3">
      <%= f.label :performed_on, "トレーニング日", class: "form-label fw-semibold" %>
      <%= f.date_field :performed_on, class: "form-control" %>
    </div>

    <ul class="nav nav-tabs mb-2" id="categoryTab">
      <% @categories.each_with_index do |category, index| %>
        <li class="nav-item">
          <button class="nav-link <%= 'active' if index == 0 %> py-2" 
                  id="tab-<%= category.id %>" 
                  data-bs-toggle="tab" 
                  data-bs-target="#category-<%= category.id %>" 
                  type="button" role="tab">
            <%= category.name %>
          </button>
        </li>
      <% end %>
    </ul>

    <div class="tab-content mb-3">
      <% @categories.each_with_index do |category, index| %>
        <div class="tab-pane fade <%= 'show active' if index == 0 %>" 
             id="category-<%= category.id %>">
          <div class="list-group list-group-flush">
            <% @exercises.where(category_id: category.id).each do |exercise| %>
              <label class="list-group-item list-group-item-action py-2 d-flex align-items-center">
                <%= f.radio_button :exercise_id, exercise.id, class: "form-check-input me-2" %>
                <span><%= exercise.name %></span>
              </label>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <div class="d-flex flex-column flex-sm-row gap-2">
      <%= f.submit "作成", class: "btn btn-success flex-grow-1 flex-sm-auto" %>
      <%= link_to "キャンセル", workouts_path(date: @workout.performed_on), class: "btn btn-secondary flex-grow-1 flex-sm-auto" %>
    </div>
  <% end %>
</div>
