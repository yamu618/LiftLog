<div class="container mt-2">
  <h2 class="mb-4">セット追加</h1>

  <% if @set.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% @set.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <p><strong>日付:</strong> <%= @workout.performed_on %></p>
  <p><strong>種目:</strong> <%= @workout.exercise.name %></p>

  <%= form_with model: @set, url: create_set_workout_path(@workout), local: true do |f| %>
    <% if @workout.exercise.category.name == "有酸素" %>
      <div class = "mb-3">
        <%= f.label :duration, "時間(分)", class: "form-label" %>
        <%= f.number_field :duration, step: 1, value: nil, class: "form-control" %>
      </div>

      <div class = "mb-3">
        <%= f.label :duration, "距離(km)", class: "form-label" %>
        <%= f.number_field :distance, step: 0.1, value: nil, class: "form-control" %>
      </div>
    <% else %>
      <div class="mb-3">
        <%= f.label :weight, "重量(kg)", class: "form-label" %>
        <%= f.number_field :weight, step: 0.1, value: nil, class: "form-control" %>
      </div>

      <div class="mb-3">
        <%= f.label :reps, "回数(回)", class: "form-label" %>
        <%= f.number_field :reps, value: nil, class: "form-control" %>
      </div>
    <% end %>

    <div class="d-flex gap-2">
      <%= f.submit "登録", class: "btn btn-success" %>
      <%= link_to "キャンセル", workout_path(@workout), class: "btn btn-secondary" %>
    </div>
  <% end %>
</div>
