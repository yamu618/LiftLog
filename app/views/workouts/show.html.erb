<div class="container mt-2">
  <h2 class="mb-4">ワークアウト詳細</h2>

  <p><strong>日付:</strong> <%= @workout.performed_on %></p>
  <p><strong>種目:</strong> <%= @workout.exercise.name %></p>

  <div>
    <% @workout.workout_sets.order(:id).each do |set| %>
      <div class="card mb-2 shadow-sm">
        <div class="card-body p-2">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="fw-bold">重量: <%= set.weight %>kg</span>
            <span class="fw-bold">回数: <%= set.reps %>回</span>
          </div>

          <div class="d-flex justify-content-end gap-1">
            <%= link_to "編集", edit_workout_set_path(set), class: "btn btn-sm btn-primary" %>
            <%= link_to "削除", workout_set_path(set),
                        data: { turbo_method: :delete, turbo_confirm: "削除しますか？" },
                        class: "btn btn-sm btn-danger" %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
  
  <div class="mt-3 d-flex flex-column flex-sm-row gap-2">
    <%= link_to "セット追加", new_set_workout_path(@workout), class: "btn btn-success flex-grow-1 flex-sm-auto" %>
    <%= link_to "ワークアウト一覧に戻る", workouts_path(date: @workout.performed_on), class: "btn btn-secondary flex-grow-1 flex-sm-auto" %>
  </div>
</div>
