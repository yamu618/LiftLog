<h1 class="mb-4">ワークアウト詳細</h1>

<p><strong>日付:</strong> <%= @workout.performed_on %></p>
<p><strong>種目:</strong> <%= @workout.exercise.name %></p>

<table class="table table-bordered table-striped align-middle">
  <thead class="table-light">
    <tr>
      <th>重量(kg)</th>
      <th>回数(回)</th>
      <th style="width: 180px;">操作</th>
    </tr>
  </thead>
  <tbody>
    <% @workout.workout_sets.order(:id).each do |set| %>
      <tr>
        <td><%= set.weight %></td>
        <td><%= set.reps %></td>
        <td>
          <div class="d-flex gap-2">
            <%= link_to "編集", edit_workout_set_path(set), class: "btn btn-sm btn-primary" %>
            <%= link_to "削除", workout_set_path(set),
                        data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？"},
                        class: "btn btn-sm btn-danger" %>
          </div>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<div class="mt-3">
  <%= link_to "セット追加", new_set_workout_path(@workout), class: "btn btn-success me-2" %>
  <%= link_to "ワークアウト一覧に戻る", workouts_path, class: "btn btn-secondary" %>
</div>
