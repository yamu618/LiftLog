<% content_for :title, "LiftLog - セット管理" %>

<% if flash[:personal_best_create] %>
  <div class="position-fixed top-0 end-0  p-3" style="z-index: 1100; pointer-events: none; margin-top: 4rem;">
    <div class="toast show align-items-center text-bg-success border-0">
      <div class="d-flex">
        <div class="toast-body" style="pointer-events: auto;">
          おめでとうございます！自己ベストを<%= flash[:personal_best_create]["amount"].round(2) %><%= flash[:personal_best_create]["type"] == "distance" ? "km" : "kg" %>更新しました🎉
        </div>
        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
      </div>
    </div>
  </div>
<% end %>

<div class="container mt-2 set-page">
  <style>
    .set-page .exercise-title { font-size: 1.2rem; font-weight: 800; margin-bottom: .25rem; }
    .set-page .meta-row { color: #6c757d; margin-bottom: .5rem; }
    .set-page .set-metric { color: #000 !important; font-size: 1.15rem; font-weight: 800; }
    @media (min-width: 992px) {
      .set-page .exercise-title { font-size: 1.4rem; }
      .set-page .set-metric { font-size: 1.2rem; }
    }
  </style>

  <h2 class="mb-4">セット管理</h2>

  <p class="meta-row"><strong>日付:</strong> <%= @workout.performed_on %></p>
  <p class="exercise-title">種目: <%= @workout.exercise.name %></p>

  <%= turbo_frame_tag dom_id(@workout, :set_list) do %>
    <div>
      <% if @workout.workout_sets.any? %>
        <% @workout.workout_sets.order(:id).each do |set| %>
          <%= render partial: "workout_sets/set", locals: { set: set } %>
        <% end %>
      <% else %>
        <div class="alert alert-light">
          セットが登録されていません。セット追加ボタン、もしくは前回記録コピーボタンからセットを登録してください。
        </div>
      <% end %>
    </div>
  <% end %>

  <div class="mt-3 d-grid gap-2">
    <%= link_to "セット追加", new_set_workout_path(@workout, date: @workout.performed_on, start_date: @start_date.beginning_of_month), class: "btn btn-outline-primary w-100" %>
    <%= link_to "前回のワークアウトからセット記録をコピー", copy_previous_sets_workout_path(@workout, date: @workout.performed_on, start_date: @start_date.beginning_of_month),
                                    data: {
                                      turbo_method: :post,
                                      turbo_confirm: "前回の記録をコピーしますか？"
                                    },
                                    class: "btn btn-outline-primary w-100" %>
    <%= link_to "ワークアウト一覧に戻る", workouts_path(date: @workout.performed_on, start_date: @start_date.beginning_of_month), class: "btn btn-secondary w-100" %>
  </div>
</div>
