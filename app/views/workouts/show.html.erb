<div class="container mt-2">
  <h2 class="mb-4">セット管理</h2>

  <p><strong>日付:</strong> <%= @workout.performed_on %></p>
  <p><strong>種目:</strong> <%= @workout.exercise.name %></p>

  <div>
    <% @workout.workout_sets.order(:id).each do |set| %>
      <%= render partial: "workout_sets/set", locals: { set: set } %>
    <% end %>
  </div>

  <div class="mt-3 d-flex flex-column flex-sm-row gap-2">
    <%= link_to "セット追加", new_set_workout_path(@workout), class: "btn btn-success flex-grow-1 flex-sm-auto" %>
    <%= link_to "ワークアウト一覧に戻る", workouts_path(date: @workout.performed_on), class: "btn btn-secondary flex-grow-1 flex-sm-auto" %>
  </div>
</div>
